# Variables de producción del frontend (Next.js).
# En Railway se setean en el panel del servicio, NO en este archivo.
# Copiar a .env.production (gitignored) solo para builds de producción locales.

# URL del backend de producción
NEXT_PUBLIC_API_URL=https://tu-backend-produccion.up.railway.app

# Google Maps API key (restringida por HTTP referrer en Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu-google-maps-api-key
